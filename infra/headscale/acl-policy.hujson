{
  "groups": {
    "group:admins": ["marcelo@"]
  },
  "tagOwners": {
    "tag:remoto-agent": ["marcelo@"]
  },
  "grants": [
    {
      "src": ["group:admins"],
      "dst": ["tag:remoto-agent"],
      "ip": ["*"]
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["tag:remoto-agent"],
      "users": ["autogroup:nonroot", "root"]
    }
  ]
}
